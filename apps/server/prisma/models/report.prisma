model Report {
    id String @id @default(cuid())

    reporterId    String?
    reporter      User?   @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: SetNull)
    reporterName  String? // snapshot, survit à la suppression du compte
    reporterEmail String?

    targetType  EntityType
    targetId    String
    targetLabel String? // snapshot lisible (nom business, titre annonce...)

    reason      ReportReason
    description String?
    evidence    Json? // captures d'écran, urls, métadonnées jointes

    status   ReportStatus   @default(PENDING)
    priority ReportPriority @default(NORMAL)

    duplicateOfId String?
    duplicateOf   Report?  @relation("ReportDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
    duplicates    Report[] @relation("ReportDuplicates")

    resolvedById   String?
    resolvedBy     User?     @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
    resolvedAt     DateTime?
    resolutionNote String?

    sanctionId String?
    sanction   Sanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)

    ipAddress String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([targetType, targetId])
    @@index([reporterId])
    @@index([status])
    @@index([reason])
    @@index([priority])
    @@index([createdAt])
    @@map("report")
}
