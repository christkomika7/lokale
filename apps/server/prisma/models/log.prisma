model ActivityLog {
    id String @id @default(cuid())

    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    userRole Role?

    userName  String?
    userEmail String?

    action String

    status LogStatus
    level  LogLevel  @default(INFO)

    message String

    errorRaw Json?

    targetType String?
    targetId   String?

    metadata Json?

    ipAddress String?
    userAgent String?

    durationMs Int?

    createdAt DateTime @default(now())

    @@index([userId])
    @@index([status])
    @@index([level])
    @@index([action])
    @@index([targetType, targetId])
    @@index([createdAt])
    @@map("activity_log")
}
