model Country {
    id        String @id @default(cuid())
    name      String
    code      String
    phoneCode String
    continent String

    currencyId String
    currency   Currency @relation(fields: [currencyId], references: [id])
    cities     City[]

    @@map("country")
}

model Currency {
    id        String    @id @default(cuid())
    name      String
    code      String
    symbol    String
    countries Country[]

    @@map("currency")
}

model City {
    id         String   @id @default(cuid())
    name       String
    region     String?
    type       CityType
    population Int?

    countryId String
    country   Country @relation(fields: [countryId], references: [id])

    @@map("city")
}
